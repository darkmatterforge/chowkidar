# --- Dev Build Stage ---
FROM golang:1.26.3-alpine

# Install dev dependencies
RUN apk add --no-cache ca-certificates git python3 py3-pip bash curl jq docker-cli nodejs npm

# Install Apprise for notifications
RUN python3 -m venv /apprise && /apprise/bin/pip install --quiet apprise && ln -sf /apprise/bin/apprise /usr/local/bin/apprise

# Install Air live-reload tool
RUN go install github.com/air-verse/air@v1.61.1

WORKDIR /src

# Copy Go module files and download dependencies
COPY go.mod go.sum ./
RUN go mod download

# Expose application port
EXPOSE 8080

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

# Default command for live reload
CMD ["air", "-c", ".air.toml"]
