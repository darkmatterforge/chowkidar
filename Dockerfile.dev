# ── Base: shared toolchain ─────────────────────────────────────────────────────
FROM cgr.dev/chainguard/wolfi-base:latest AS base

RUN apk upgrade --no-cache && \
    apk add --no-cache ca-certificates git go python3 py3-pip bash curl jq docker-cli nodejs npm && \
    python3 -m venv /apprise && \
    /apprise/bin/pip install --quiet apprise && \
    mkdir -p /usr/local/bin && \
    ln -sf /apprise/bin/apprise /usr/local/bin/apprise

RUN GOBIN=/usr/local/bin go install github.com/air-verse/air@v1.61.1

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

CMD ["air", "-c", ".air.toml"]

# ── Frontend: Vite dev server ──────────────────────────────────────────────────
FROM base AS frontend

WORKDIR /src/web-next

EXPOSE 5173

HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:5173/ || exit 1

CMD ["sh", "-c", "npm install && npm run dev"]
